{
  "manifest_version": 3,
  "name": "Mathdeck Keyboard",
  "description": "A compact math keyboard for writing, copying, and inserting equations.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/mathdeck.svg",
    "32": "icons/mathdeck.svg",
    "48": "icons/mathdeck.svg",
    "128": "icons/mathdeck.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mathdeck Keyboard"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ]
}
