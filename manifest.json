{
  "manifest_version": 3,
  "name": "Mathdeck Keyboard",
  "description": "A compact math keyboard for writing, copying, and inserting equations.",
  "version": "0.2.0",
  "icons": {
    "16": "icons/mathdeck-16.png",
    "32": "icons/mathdeck-32.png",
    "48": "icons/mathdeck-48.png",
    "128": "icons/mathdeck-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mathdeck Keyboard"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ]
}
